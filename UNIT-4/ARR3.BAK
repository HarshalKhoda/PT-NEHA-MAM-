//program to find n elements and find maximum and minimum
#include<stdio.h>
#include<conio.h>
int main()
{
int a[100],n,i,max,min;
clrscr();
printf("enter first number element:");
scanf("%d",&n);
printf("enter elements:\n");
for(i=0;i<n;i++)
{
scanf("%d",&a[i]);
}
max=a[0];
min=a[0];
for(i=1;i<n;i++)
{
if(a[i] > max)
max = a[i];
if(a[i] < min)
min = a[i];
}
printf("maximum=%d\n",max);
printf("minimum=%d\n",min);
getch();
return 0;
}
