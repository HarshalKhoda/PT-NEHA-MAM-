//programprogram to subtract two matrix
#include<stdio.h>
#include<conio.h>
int main()
{
int a[10][10],b[10][10],c[10][10];
int r,col,i,j;
clrscr();
printf("enter rows and column:");
scanf("%d %d",&r,&col);
printf("enter first matrix:\n");
for(i=0;i<r;i++)
{
 for(j=0;j<col;j++)
 {
 scanf("%d",&a[i][j]);
 }
 }
 printf("enter second matrix:\n");
 for(i=0;i<r;i++)
 {
 for(j=0;j<col;j++)
 {
 scanf("%d",b[i][j]);
 }
 }
 for(i=0;i<r;i++)
 {
 for(j=0;j<col;j++)
  {
  c[i][j] = a[i][j] - b[i][j];
  }
  }
  printf("difference of matrices:\n");
  for(i=0;i<r;i++)
  {
  for(j=0;j<col;j++)
  {
  printf("%d",c[i][j]);
  }
  printf("\n");
  }
  getch();
  return 0;
  }