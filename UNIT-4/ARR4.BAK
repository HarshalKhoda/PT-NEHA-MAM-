//program to print n count,positive,negative,even odd
#include<stdio.h>
#include<conio.h>
int main()
{
int a[100],n,i;
int pos=0, neg=0, even=0,odd=0;
clrscr();
printf("Enter number of element:");
scanf("%d",&n);
printf("Enter elements:\n");
for(i=0;i<n;i++)
{
scanf("%d",&a[i]);
}
for(i=0;i<n;i++)
{
if(a[i] > 0)
  pos++;
if(a[i] < 0)
  neg++;
if(a[i]%2 ==0)
  even++;
else
  odd++;
  }
  printf("positive number = %d\n",pos);
  printf("negative number =%d\n",neg);
  printf("even number = %d\n",even);
  printf("odd number = %d\n",odd);
  getch();
  return 0;
  }